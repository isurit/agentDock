{
  "name": "agentdock",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "NODE_ENV=production tsx apps/server/src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "privacy": "node scripts/privacy.mjs",
    "sample": "node scripts/sample.mjs",
    "verify:codex": "tsx scripts/verify-codex.ts",
    "doctor": "tsx scripts/doctor.ts",
    "verify:headless": "tsx scripts/verify-headless.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
